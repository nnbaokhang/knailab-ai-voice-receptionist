NODE_ENV=development
PORT=8080
BASE_URL=https://your-public-host.example
MOCK_INTEGRATIONS=true

# Shared Vapi Server URL credential; configure Vapi to send Authorization: Bearer <value>.
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Protects event replay and local demo state endpoints.
ADMIN_API_KEY=replace-with-a-different-long-random-secret
# Base64-encoded 32-byte key. Required for durable encrypted replay storage.
EVENT_STORE_ENCRYPTION_KEY=
EVENT_STORE_PATH=./data/events.json

# Optional direct OpenAI call for deterministic structured call summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HighLevel / GoHighLevel Private Integration Token or OAuth access token.
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Optional Make.com Custom Webhook URL for post-call automation.
MAKE_POST_CALL_WEBHOOK_URL=

# Google Calendar API for live Vapi availability and booking tools.
# These OAuth credentials are separate from Make's Google Calendar connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Denver
GOOGLE_BUSINESS_START_HOUR=9
GOOGLE_BUSINESS_END_HOUR=17
GOOGLE_SLOT_DURATION_MINUTES=60
GOOGLE_DAYS_AHEAD=7
GOOGLE_MIN_NOTICE_MINUTES=120

HTTP_TIMEOUT_MS=8000
RETRY_MAX_ATTEMPTS=3
